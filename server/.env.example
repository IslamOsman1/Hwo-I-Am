# Node does not read .env automatically. Use: node --env-file=.env src/server.js
PORT=3000
DATA_DIR=./storage
# Atlas runtime credentials belong only in Render Environment, never the APK.
MONGODB_URI=
MONGODB_DB=menana
# Your coturn hostname, not the Render game server hostname:
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Same value as coturn's static-auth-secret. Never put this in the Android app.
TURN_SECRET=replace-with-a-long-random-secret
# Managed providers: leave TURN_SECRET empty and set the following instead.
TURN_USERNAME=
TURN_CREDENTIAL=
